machine(MachineType:Directory, "Directory protocol"):
    XYZCacheMemory *xyzCacheMemory;
    XYZStatsObject *xyzStatsObject;
    TDMSwitch* bus;
    Cycles toMemLatency := 1;
    Cycles responseBusLatency := 1;
    int sum_prv_cores := 0;
    int sum_prv_capacity := 0;
    bool enforce_roc := 0;
    int wb_buffer_size := 0;
    bool delayMarkDone := 0;

MessageBuffer *forwardToCache, network = "To", virtual_network = "1", vnet_type = "forward";
MessageBuffer *responseToCache, network = "To", virtual_network = "2", vnet_type = "response";
MessageBuffer *requestFromCache, network = "From", virtual_network = "0", vnet_type = "request";
MessageBuffer *responseFromCache, network = "From", virtual_network = "2", vnet_type = "response";

// We don't need these channels for FlexLLC...
bool splitBus;
MessageBuffer *requestToOrder, network = "To", virtual_network = "3", vnet_type = "request";
MessageBuffer *requestFromOrdered, network = "From", virtual_network = "3", vnet_type = "request";                           
MessageBuffer * responseToBusOnly, network="To", virtual_network="6", vnet_type="response";
MessageBuffer * responseFromBusOnly, network="From", virtual_network="6", vnet_type="response";
// ... but deleting them causes errors

MessageBuffer *requestToMemory;
MessageBuffer *responseFromMemory;
{
    state_declaration(State, desc="Directory states", default="Directory_State_I") {
        // stable states
        M, AccessPermission:Invalid, desc="";
        S, AccessPermission:Read_Only, desc="";
        I, AccessPermission:Read_Write, desc="";
        LOC, AccessPermission:Read_Write, desc="LLC_Only_Clean";
        LOD, AccessPermission:Read_Write, desc="LLC_Only_Dirty";
        
        M_NI, AccessPermission:Invalid, desc="";
        S_NI, AccessPermission:Invalid, desc="";

        // transient states
        I_to_S_await_mem_data, AccessPermission:Busy, desc="";
        I_to_M_await_mem_data, AccessPermission:Busy, desc="";
        LOD_to_LOC_await_ack, AccessPermission:Read_Only, desc="";

        I_to_S_await_mem_data_NI, AccessPermission:Busy, desc="";
        I_to_M_await_mem_data_NI, AccessPermission:Busy, desc="";
        DirtyNI_to_I_await_ack, AccessPermission:Busy, desc="";
    }

    enumeration(Event, desc="Directory events") {
        GetS, desc="";
        GetM, desc="";

        GetS_NI, desc="";
        GetM_NI_From_NonSharer, desc="";
        GetM_NI_From_Sharer, desc="";

        PutS_NotLastCopy, desc="";
        PutS_LastCopy_Clean, desc="";
        PutS_LastCopy_Dirty, desc="";
        PutS_LastCopy_Dirty_WriteThrough, desc="";
        PutM, desc="";
        PutM_WriteThrough, desc="";
        PutLOD, desc="";
        Put_InvalidReq, dest="";

        PutS_NotLastCopy_NI_BypassLLC, desc="";
        PutS_NotLastCopy_NI_InsertToLLC, desc="";
        PutS_LastCopy_Clean_NI_BypassLLC, desc="";
        PutS_LastCopy_Clean_NI_InsertToLLC, desc="";
        PutS_LastCopy_Dirty_NI_BypassLLC, desc="";
        PutS_LastCopy_Dirty_NI_InsertToLLC, desc="";
        PutM_NI_BypassLLC, desc="";
        PutM_NI_InsertToLLC, desc="";

        MemData, desc="";
        MemAck, desc="";
        InvAck, desc="";
    }

    // structures

    structure(TBE, desc="MSHR like requests", main="false") {
        State TBEState,         desc="State of block";
        DataBlock DataBlk,      desc="Data for the block. Needed for MI_A";
    }

    structure(Entry, desc="...", interface="AbstractCacheEntry") {
        State DirState,         desc="Directory state";
        DataBlock DataBlk,      desc="Data in the block";
    }

    structure(TBETable, external="yes") {
        TBE lookup(Addr);
        void allocate(Addr);
        void deallocate(Addr);
        bool isPresent(Addr);
        int cnt();
        void clr();
    }
    TBETable TBEs, template="<Directory_TBE>", constructor="m_number_of_TBEs";
    Tick clockEdge();

    // functions 
    
    Entry getCacheEntry(Addr addr), return_by_pointer = "yes" {
        return static_cast(Entry, "pointer", xyzCacheMemory.lookup(addr));
    }

    void set_cache_entry(AbstractCacheEntry a);
    void unset_cache_entry();
    void set_tbe(TBE b);
    void unset_tbe();
    Tick cyclesToTicks(Cycles c);
    Cycles curCycle();
    Cycles ticksToCycles(Tick t);
    void wakeUpAllBuffers();

    State getNIState(Addr addr) {
        assert(xyzCacheMemory.containNILine(addr));
        // if the line is IN, state should be decided by XYZCacheMemory
        if (xyzCacheMemory.getNIState(addr) == 1) {
            return State:S_NI;
        } else if (xyzCacheMemory.getNIState(addr) == 2) {
            return State:M_NI;
        } else if (xyzCacheMemory.getNIState(addr) == 3) {
            return State:I_to_S_await_mem_data_NI;
        } else if (xyzCacheMemory.getNIState(addr) == 4) {
            return State:I_to_M_await_mem_data_NI;
        } else if (xyzCacheMemory.getNIState(addr) == 5) {
            return State:DirtyNI_to_I_await_ack;
        }
    }

    State getState(TBE tbe, Entry cache_entry, Addr addr) {
        if(is_valid(tbe)) {
            return tbe.TBEState;
        } else if(is_valid(cache_entry)) {
            return cache_entry.DirState;
        } else if (xyzCacheMemory.containNILine(addr)) {
            return getNIState(addr);
        }
        return State:I;
    }

    void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
        // Note: only handle the states of IN lines
        if(is_valid(tbe)) {
            tbe.TBEState := state;
        }
        if(is_valid(cache_entry)){
            cache_entry.DirState := state;
        }
    }

    AccessPermission getAccessPermission(Addr addr) {
        Entry e := getCacheEntry(addr);
        if (is_valid(e)) {
            return Directory_State_to_permission(e.DirState);
        }
        if (xyzCacheMemory.containNILine(addr)) {
            return Directory_State_to_permission(getNIState(addr));
        }
        return AccessPermission:Read_Write;
    }

    void setAccessPermission(Entry cache_entry, Addr addr, State state) {
        if(is_valid(cache_entry)) {
            cache_entry.changePermission(Directory_State_to_permission(state));
        }
    }

    void functionalRead(Addr addr, Packet *pkt) {
        Entry e := getCacheEntry(addr);
        if(is_valid(e)) {
            testAndRead(addr, e.DataBlk, pkt);
        } else {
            functionalMemoryRead(pkt);
        }
    }

    int functionalWrite(Addr addr, Packet *pkt) {
        Entry e := getCacheEntry(addr);
        int num_functional_writes := 0;
        if(is_valid(e)) {
            num_functional_writes := num_functional_writes + testAndWrite(addr, e.DataBlk, pkt);
            if(functionalMemoryWrite(pkt)) {
                num_functional_writes := num_functional_writes + 1;
            }
            return num_functional_writes;
        }  
        if (functionalMemoryWrite(pkt)) {
            num_functional_writes := num_functional_writes + 1;
        }
        return num_functional_writes;
    }

    include "LC-MSI-dir-ports.sm";

    // message actions

    action(sendMemRead, desc="Send a memory read request") {
        peek(request_in, RequestMsg) {
            enqueue(memQueue_out, MemoryMsg, toMemLatency) {
                out_msg.addr := address;
                out_msg.Type := MemoryRequestType:MEMORY_READ;
                out_msg.Sender := in_msg.Requestor;
                out_msg.MessageSize := MessageSizeType:Request_Control;
                out_msg.Len := 0;
            }
            DPRINTF(FlexLLC, "[SendMemRead: Address = %#x, Sender = %s] \n", address, in_msg.Requestor);
        }
    }

    action(sendDataToMem, desc="") {
        peek(request_in, RequestMsg) {
            enqueue(memQueue_out, MemoryMsg, toMemLatency) {
                out_msg.addr := address;
                out_msg.Type := MemoryRequestType:MEMORY_WB;
                out_msg.Sender := in_msg.Requestor;
                out_msg.MessageSize := MessageSizeType:Writeback_Data;
                out_msg.DataBlk := in_msg.DataBlk;
                out_msg.Len := 0;
            }
            DPRINTF(FlexLLC, "[SendDataToMem: Address = %#x, Sender = %s] \n", address, in_msg.Requestor);
        }
    }

    action(sendLLCDataToMem, desc="") {
        enqueue(memQueue_out, MemoryMsg, toMemLatency) {
            out_msg.addr := address;
            out_msg.Type := MemoryRequestType:MEMORY_WB;
            out_msg.Sender := machineID;
            out_msg.MessageSize := MessageSizeType:Writeback_Data;
            out_msg.DataBlk := cache_entry.DataBlk;
            out_msg.Len := 0;
        }
        DPRINTF(FlexLLC, "[SendLLCDataToMem: Address = %#x, Sender = %s] \n", address, machineID);
    }

    action(sendInvToSharersFromReq, desc="") {
        peek(request_in, RequestMsg) {
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:Inv;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination := xyzCacheMemory.getSharers(address);
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[sendInvToSharersFromReq: Address = %#x, Requestor = %s, Destination = %s] \n", address, in_msg.Requestor, xyzCacheMemory.getSharers(address));
        }
    }

    action(sendInvToSharersFromLLC, desc="") {
        peek(request_in, RequestMsg) {
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:Inv;
                out_msg.Requestor := machineID;
                out_msg.Destination := xyzCacheMemory.getSharers(address);
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[sendInvToSharersFromLLC: Address = %#x, Requestor = %s, Destination = %s] \n", address, machineID, xyzCacheMemory.getSharers(address));
        }
    }

    action(sendFwdGetS, desc="") {
        peek(request_in, RequestMsg) {
            NetDest dest := xyzCacheMemory.getASharer(address);
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:GetS;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination := dest;
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[SendFwdGetS: Address = %#x, Requestor = %s, Destination = %s] \n", address, in_msg.Requestor, dest);
        }
    }

    action(sendFwdGetMFromM, desc="") {
        peek(request_in, RequestMsg) {
            NetDest dest := xyzCacheMemory.getOwner(address);
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:GetM;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination := dest;
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[SendFwdGetMFromM: Address = %#x, Requestor = %s, Destination = %s] \n", address, in_msg.Requestor, dest);
        }
    }

    action(sendFwdGetMFromS, desc="") {
        peek(request_in, RequestMsg) {
            NetDest dest := xyzCacheMemory.getASharer(address);
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:GetM;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination := dest;
                out_msg.MessageSize := MessageSizeType:Control;
            }
            xyzCacheMemory.removeSharer(address, dest.smallestElement());
            DPRINTF(FlexLLC, "[SendFwdGetMFromS: Address = %#x, Requestor = %s, Destination = %s] \n", address, in_msg.Requestor, dest);
        }
    }

    action(sendUpgradeToReq, desc="") {
        peek(request_in, RequestMsg) {
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:Upgrade;
                out_msg.Requestor := in_msg.Requestor;
                out_msg.Destination.add(in_msg.Requestor);
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[SendUpgradeToReq: Address = %#x, Requestor = %s, Destination = %s] \n", address, in_msg.Requestor, in_msg.Requestor);
        }
    }

    action(sendLLCDataToReq, desc="") {
        assert(is_valid(cache_entry));
        peek(request_in, RequestMsg) {
            enqueue(response_out, ResponseMsg, responseBusLatency) {
                out_msg.addr := address;
                out_msg.Type := CoherenceResponseType:Data;
                out_msg.Sender := machineID;
                out_msg.Destination.add(in_msg.Requestor);
                out_msg.DataBlk := cache_entry.DataBlk;
                out_msg.MessageSize := MessageSizeType:Response_Data;
                out_msg.OriginalRequestor := in_msg.Requestor;
                if (xyzCacheMemory.getOwner(address).isElement(in_msg.Requestor)) {
                    out_msg.Acks := xyzCacheMemory.getSharers(address).count();
                } else {
                    out_msg.Acks := 0;
                }
                xyzCacheMemory.setMRU(cache_entry);
            }
            DPRINTF(FlexLLC, "[SendLLCDataToReq: Address = %#x, OriginalRequestor = %s, Sender = %s, Destination = %s] \n", address, in_msg.Requestor, machineID, in_msg.Requestor);
        }
    }

    action(sendMemDataToReq, desc="") {
        peek(memQueue_in, MemoryMsg) {
            enqueue(response_out, ResponseMsg, responseBusLatency) {
                out_msg.addr := address;
                out_msg.Type := CoherenceResponseType:Data;
                out_msg.Sender := machineID;
                out_msg.Destination.add(in_msg.OriginalRequestorMachId);
                out_msg.DataBlk := in_msg.DataBlk;
                out_msg.MessageSize := MessageSizeType:Data;
                out_msg.OriginalRequestor := in_msg.OriginalRequestorMachId;
                if (xyzCacheMemory.getOwner(address).isElement(in_msg.OriginalRequestorMachId)) {
                    out_msg.Acks := xyzCacheMemory.getSharers(address).count();
                } else {
                    out_msg.Acks := 0;
                }
            }
            DPRINTF(FlexLLC, "[SendMemDataToReq: Address = %#x, OriginalRequestor = %s, Sender = %s, Destination = %s] \n", address, in_msg.OriginalRequestorMachId, machineID, in_msg.OriginalRequestorMachId);
        }
    }

    action(sendPutAck, desc="") {
        peek(request_in, RequestMsg) {
            enqueue(forward_out, RequestMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceRequestType:PutAck;
                out_msg.Requestor := machineID;
                out_msg.Destination.add(in_msg.Requestor);
                out_msg.MessageSize := MessageSizeType:Control;
            }
            DPRINTF(FlexLLC, "[sendPutAck: Address = %#x, Requestor = %s, Destination = %s] \n", address, machineID, in_msg.Requestor);
        }
    }

    // functional actions

    action(copyRequestDataToLLC, desc="") {
        peek(request_in, RequestMsg) {      
            assert(is_valid(cache_entry));
            cache_entry.DataBlk := in_msg.DataBlk;
        }
    }

    action(markLLCDone, desc="") {
        bus.markLLCDone();
    }

    action(markLLCDone_await_data, desc="") {
        bus.markLLCDone(true);
    }

    action(markLLCDone_if_not_delayed, desc="") {
        if(!delayMarkDone) {
            bus.markLLCDone();
        }
    }

    action(setDelayMarkDone, desc="") {
        delayMarkDone := true;
    }

    action(unsetDelayMarkDone, desc="") {
        delayMarkDone := false;
    }

    action(xyzAddSharer, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.addSharer(in_msg.addr, in_msg.Requestor, true);        
        }
    }

    action(xyzRemoveSharer, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.removeSharer(in_msg.addr, in_msg.Requestor);
        }
    }

    action(xyzClearSharers, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.clearSharers(in_msg.addr);
        }
    }

    action(xyzAddOwner, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.addOwner(in_msg.addr, in_msg.Requestor, true);
        }
    }

    action(xyzClearOwner, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.clearOwner(in_msg.addr);
        }
    }

    action(xyzConvertOwnerToSharer, desc="") {
        peek(request_in, RequestMsg) {
            if (xyzCacheMemory.containLLCLine(in_msg.addr)) {
                xyzCacheMemory.convertOwnerToSharer(in_msg.addr, true);
            } else if (xyzCacheMemory.containNILine(in_msg.addr)) {
                xyzCacheMemory.convertOwnerToSharer(in_msg.addr, false);
            } else {
                assert(false);
            }
        }
    }

    action(xyzSetIsDirty, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.setIsDirty(in_msg.addr);
        }
    }

    action(xyzUnsetIsDirty, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.unSetIsDirty(in_msg.addr);
        }
    }

    action(xyzConvertNILineToIN, desc="") {
        xyzCacheMemory.convertNILineToIN(address);
    }

    action(popRequestQueue, desc="") {
        request_in.dequeue(clockEdge());
    }
    
    action(popResponseQueue, desc="") {
        response_in.dequeue(clockEdge());
    }

    action(popMemQueue, desc="") {
        memQueue_in.dequeue(clockEdge());
    }

    action(allocateCacheBlock, desc="") {
        set_cache_entry(xyzCacheMemory.allocate(address, new Entry));
    }

    action(writeMemDataToLLC, desc="") {
        peek(memQueue_in, MemoryMsg) {
            cache_entry.DataBlk := in_msg.DataBlk;
        }
    }

    action(writePrivateCacheDataToLLC, desc="") {
        peek(request_in, RequestMsg) {      
            cache_entry.DataBlk := in_msg.DataBlk;
        }
    }

    action(wakeUpBuffers, desc="") {
        wakeUpAllBuffers();
    }

    // NI actions

    action(setNITransientStateTo_I_to_S_await_mem_data_NI, desc="") {
        xyzCacheMemory.setNITransientState(address, 3);
    }

    action(setNITransientStateTo_I_to_M_await_mem_data_NI, desc="") {
        xyzCacheMemory.setNITransientState(address, 4);
    }

    action(setNITransientStateTo_DirtyNI_to_I_await_ack, desc="") {
        xyzCacheMemory.setNITransientState(address, 5);
    }

    action(unsetNITransientState, desc="") {
        xyzCacheMemory.setNITransientState(address, 0);
    }

    action(xyzAddSharerNI, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.addSharer(in_msg.addr, in_msg.Requestor, false);        
        }
    }

    action(xyzAddOwnerNI, desc="") {
        peek(request_in, RequestMsg) {
            xyzCacheMemory.addOwner(in_msg.addr, in_msg.Requestor, false);
        }
    }
    
    action(xyzDeallocateMetadataNI, desc="") {
        xyzCacheMemory.removeLineFromNIDirectory(address);
    }

    // transitions

    transition({M_NI, S_NI}, InvAck) {
        popResponseQueue;
    }

    transition({S, S_NI, M, M_NI}, Put_InvalidReq) {
        sendPutAck;
        popRequestQueue;
        markLLCDone;
    }

    // 1. transitions from LOC / LOD

    transition(LOD, PutLOD, LOD_to_LOC_await_ack) {
        sendLLCDataToMem;
        xyzUnsetIsDirty;
    }

    transition(LOD_to_LOC_await_ack, MemAck, LOC) {
        popMemQueue;
        wakeUpBuffers;
        markLLCDone;
    }

    transition({LOC, LOD}, GetS, S) {
        xyzAddSharer;
        sendLLCDataToReq;
        popRequestQueue;
        markLLCDone_await_data;
    }

    transition({LOC, LOD}, GetM, M) {
        xyzAddOwner;
        xyzSetIsDirty;
        sendLLCDataToReq;
        popRequestQueue;
        markLLCDone_await_data;
    }

    // 2. transitions from I

    transition(I, GetS, I_to_S_await_mem_data) {
        allocateCacheBlock;
        xyzAddSharer;
        sendMemRead;
        popRequestQueue;
    }

    transition(I, GetM, I_to_M_await_mem_data) {
        allocateCacheBlock;
        xyzAddOwner;
        xyzSetIsDirty;
        sendMemRead;
        popRequestQueue;
    }

    transition(I_to_S_await_mem_data, MemData, S) {
        sendMemDataToReq;
        writeMemDataToLLC;
        popMemQueue;
        markLLCDone_await_data;
    }

    transition(I_to_M_await_mem_data, MemData, M) {
        sendMemDataToReq;
        writeMemDataToLLC;
        popMemQueue;
        markLLCDone_await_data;
    }

    // 3. transitions from S

    transition(S, GetS) {
        sendLLCDataToReq;
        xyzAddSharer;
        popRequestQueue;
        markLLCDone_await_data;
    }

    transition(S, GetM, M) {
        xyzRemoveSharer;
        sendInvToSharersFromReq;
        xyzAddOwner;
        xyzSetIsDirty;
        sendLLCDataToReq;
        xyzClearSharers;
        popRequestQueue;
        markLLCDone_await_data;
    }

    transition(S, PutS_NotLastCopy) {
        sendPutAck;
        xyzRemoveSharer;
        popRequestQueue;
        markLLCDone;
    }

    transition(S, PutS_LastCopy_Clean, LOC) {
        sendPutAck;
        xyzRemoveSharer;
        popRequestQueue;
        markLLCDone;
    }

    transition(S, PutS_LastCopy_Dirty, LOD) {
        sendPutAck;
        xyzRemoveSharer;
        popRequestQueue;
        markLLCDone;
    }

    transition(S, PutS_LastCopy_Dirty_WriteThrough, LOD_to_LOC_await_ack) {
        sendDataToMem;
        sendPutAck;
        xyzUnsetIsDirty;
        xyzRemoveSharer;
        popRequestQueue;
    }

    // 4. transitions from M

    transition(M, GetS) {
        sendFwdGetMFromM;
        xyzClearOwner;
        xyzAddOwner;
        popRequestQueue;
        markLLCDone;
    }

    transition(M, GetM) {
        sendFwdGetMFromM;
        xyzClearOwner;
        xyzAddOwner;
        popRequestQueue;
        markLLCDone;
    }

    transition(M, PutM, LOD) {
        copyRequestDataToLLC;
        sendPutAck;
        xyzClearOwner;
        popRequestQueue;
        markLLCDone;
    }

    transition(M, PutM_WriteThrough, LOD_to_LOC_await_ack) {
        copyRequestDataToLLC;
        sendDataToMem;
        sendPutAck;
        xyzUnsetIsDirty;
        xyzClearOwner;
        popRequestQueue;
    }

    // transitions for NI

    // 5. transitions between I and NI

    transition(I, GetS_NI, I_to_S_await_mem_data_NI) {
        xyzAddSharerNI;
        setNITransientStateTo_I_to_S_await_mem_data_NI;
        sendMemRead;
        popRequestQueue;
    }

    transition(I, GetM_NI_From_NonSharer, I_to_M_await_mem_data_NI) {
        xyzAddOwnerNI;
        xyzSetIsDirty;
        setNITransientStateTo_I_to_M_await_mem_data_NI;
        sendMemRead;
        popRequestQueue;
    }

    transition(I_to_S_await_mem_data_NI, MemData, S_NI) {
        unsetNITransientState;
        sendMemDataToReq;
        popMemQueue;
        markLLCDone_await_data;
    }

    transition(I_to_M_await_mem_data_NI, MemData, M_NI) {
        unsetNITransientState;
        sendMemDataToReq;
        popMemQueue;
        markLLCDone_await_data;
    }

    // 6. transitions for S_NI

    transition(DirtyNI_to_I_await_ack, MemAck, I) {
        unsetNITransientState;
        xyzDeallocateMetadataNI;
        popMemQueue;
        wakeUpBuffers;
        markLLCDone;
    }

    transition(S_NI, PutS_NotLastCopy_NI_BypassLLC) {
        sendPutAck;
        xyzRemoveSharer;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, PutS_NotLastCopy_NI_InsertToLLC, S) {
        sendPutAck;
        xyzRemoveSharer;
        allocateCacheBlock;
        copyRequestDataToLLC;
        xyzConvertNILineToIN;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, PutS_LastCopy_Clean_NI_BypassLLC, I) {
        sendPutAck;
        xyzDeallocateMetadataNI;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, PutS_LastCopy_Clean_NI_InsertToLLC, LOC) {
        sendPutAck;
        xyzRemoveSharer;
        allocateCacheBlock;
        copyRequestDataToLLC;
        xyzConvertNILineToIN;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, PutS_LastCopy_Dirty_NI_BypassLLC, DirtyNI_to_I_await_ack) {
        sendDataToMem;
        sendPutAck;
        xyzUnsetIsDirty;
        xyzRemoveSharer;
        setNITransientStateTo_DirtyNI_to_I_await_ack;
        popRequestQueue;
    }

    transition(S_NI, PutS_LastCopy_Dirty_NI_InsertToLLC, LOD) {
        sendPutAck;
        xyzRemoveSharer;
        allocateCacheBlock;
        copyRequestDataToLLC;
        xyzConvertNILineToIN;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, GetS_NI) {
        sendFwdGetS;
        xyzAddSharerNI;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, GetM_NI_From_NonSharer, M_NI) {
        sendFwdGetMFromS;
        sendInvToSharersFromLLC;
        xyzClearSharers;
        xyzAddOwnerNI;
        xyzSetIsDirty;
        popRequestQueue;
        markLLCDone;
    }

    transition(S_NI, GetM_NI_From_Sharer, M_NI) {
        xyzRemoveSharer;
        sendInvToSharersFromLLC;
        xyzClearSharers;
        xyzAddOwnerNI;
        xyzSetIsDirty;
        sendUpgradeToReq;
        popRequestQueue;
        markLLCDone;
    }

    // 7. transitions for M_NI

    transition(M_NI, GetS_NI) {
        sendFwdGetMFromM;
        xyzClearOwner;
        xyzAddOwnerNI;
        popRequestQueue;
        markLLCDone;
    }
    
    transition(M_NI, GetM_NI_From_NonSharer) {
        sendFwdGetMFromM;
        xyzClearOwner;
        xyzAddOwnerNI;
        popRequestQueue;
        markLLCDone;
    }

    transition(M_NI, PutM_NI_BypassLLC, DirtyNI_to_I_await_ack) {
        setNITransientStateTo_DirtyNI_to_I_await_ack;
        sendDataToMem;
        xyzUnsetIsDirty;
        sendPutAck;
        xyzClearOwner;
        popRequestQueue;
    }

    transition(M_NI, PutM_NI_InsertToLLC, LOD) {
        sendPutAck;
        xyzClearOwner;
        allocateCacheBlock;
        copyRequestDataToLLC;
        xyzConvertNILineToIN;
        popRequestQueue;
        markLLCDone;
    }

}